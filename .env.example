APP_NAME="PulseFit Enterprise API"
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/pulsefit
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=pulsefit-api
JWT_AUDIENCE=pulsefit-clients
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
CORS_ORIGINS='["http://localhost:19006","http://localhost:8081","http://localhost:8082","http://localhost:3000","http://127.0.0.1:8081","http://127.0.0.1:8082"]'
CORS_ORIGIN_REGEX='^https?://(localhost|127(?:\.\d{1,3}){3}|10(?:\.\d{1,3}){3}|192\.168(?:\.\d{1,3}){2}|172\.(?:1[6-9]|2\d|3[0-1])(?:\.\d{1,3}){2}):\d+$'
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
PUBLIC_WRITE_RATE_LIMIT_PER_MINUTE=30
MAX_REQUEST_BODY_BYTES=1048576
